{
    "name": "ku-potato",
    "private": true,
    "type": "module",
    "scripts": {
        "cli": "deno run --allow-all --unsafe-proto cli/main.ts",
        "db:generate": "drizzle-kit generate --config=sqlite/drizzle.config.ts",
        "check": "deno check cli/main.ts sqlite/drizzle.config.ts",
        "test": "deno test --allow-all --unsafe-proto",
        "lint": "deno lint && deno task oxlint",
        "oxlint": "effect-tsgo patch --oxlint --no-typescript && mkdir -p types && deno types > types/deno.d.ts && oxlint"
    },
    "dependencies": {
        "@effect/platform-deno": "4.0.0",
        "drizzle-orm": "1.0.0-rc.4",
        "effect": "4.0.0",
        "gunshi": "0.37.3",
        "playwright-core": "1.63.0"
    },
    "devDependencies": {
        "@std/assert": "jsr:1",
        "@types/node": "24.0.0",
        "@effect/tsgo": "0.45.0",
        "drizzle-kit": "1.0.0-rc.4",
        "oxlint": "1.82.0",
        "oxlint-tsgolint": "7.0.2001"
    }
}
