{
    "$schema": "https://raw.github.com/denoland/deno/main/cli/schemas/config-file.v1.json",
    "nodeModulesDir": "auto",
    "unstable": ["tsgo"],
    "exclude": ["types"],
    "lint": {
        "rules": {
            "exclude": ["no-slow-types"]
        }
    },
    "fmt": {
        "exclude": ["domain/docs", "sqlite/drizzle"],
        "lineWidth": 120
    }
}
